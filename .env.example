# Copy to .env and add credentials only for providers you choose to use.
# JARVIS prefers local model runtimes (LM Studio or Ollama); no API key is needed locally.

# Optional cloud providers
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Optional OpenAI-compatible backend (leave blank for auto-detected local models)
JARVIS_MODEL_API_KEY=
JARVIS_MODEL_BASE_URL=
JARVIS_MODEL_NAME=

# Optional local runtime configuration
JARVIS_LOCAL_MODEL_BASE_URL=
JARVIS_LOCAL_MODEL_AUTOLOAD=1

# Optional integrations
N8N_API_KEY=
